# ---- 凭据与本地状态（绝对不要提交）----
.cache/
*.token
steam-token*.json
webcookies.json

# ---- 依赖与构建产物 ----
node_modules/
dist/
output/
downloads/
logs/
android/app/build/
android/.gradle/
android/app/src/main/jniLibs/
android/backup/
android/app/assets/nodejs-project/

# ---- 第三方二进制（Valve 的 SteamCMD，版权归 Valve，别进仓库）----
steamcmd/
*.dll
*.so
*.so.bak
*.apk
*.zip
*.exe

# Rust 编译产物（CI 构建时临时放进 bin/ 打包，不进仓库）
rust/tex-cli/target/
bin/rust-tex

# ---- 系统与编辑器 ----
.DS_Store
Thumbs.db
desktop.ini
*.log
*.tmp
.vscode/
.idea/

# ---- 例外：文档/脚本里用到的图片与示例保留 ----
!assets/**
# assets 里的 JS 工程包（构建产物，但要跟着仓库走，否则 APK 缺依赖）
!android/app/src/main/assets/nodejs-project.zip
!android/app/src/main/assets/nodejs-build.json

# 本机构建路径（每台机器不同）
local.properties


# 测试脚本生成的样例图（含第三方壁纸素材，不入库）
tools/_sample.png


# ---- 签名材料（绝对不要提交到仓库或 Release）----
*.jks
*.keystore
keystore.properties
signing/
