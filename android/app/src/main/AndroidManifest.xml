<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 后台下载/打包保活：前台服务 + 通知（Android 13+ 通知需运行时授权，拒绝也能跑，只是看不到通知） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 自定义下载目录（写到 /storage/emulated/0/Download/... ）需要「所有文件访问」；
         这是自己侧载的工具，不走 Play，所以直接用 MANAGE_EXTERNAL_STORAGE。 -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />

    <!-- Android 11+ 包可见性：要能查询/拉起壁纸引擎（安卓官方客户端） -->
    <queries>
        <package android:name="io.wallpaperengine.weclient" />
    </queries>

    <application
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 后台保活：下载/打包期间挂一条前台通知，降低被系统回收的概率 -->
        <service
            android:name=".KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 把成品 mpkg 以 content:// 授权给壁纸引擎（不依赖 androidx FileProvider） -->
        <provider            android:name=".MpkgProvider"
            android:authorities="com.wempkg.app.mpkg"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
