<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 及以下：即使以后误开启 allowBackup，也不把应用私有文件带出去。
     steam-token.json 位于 filesDir/nodejs-project/.cache，属于 file 域。 -->
<full-backup-content>
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
